import os
from pathlib import Path

from dotenv import load_dotenv
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
from google import genai

load_dotenv(Path(__file__).with_name(".env"))

app = FastAPI(
    title="RAMA AI API",
    version="0.1.0"
)

origins = os.getenv(
    "FRONTEND_ORIGINS",
    "http://localhost:5173"
).split(",")

app.add_middleware(
    CORSMiddleware,
    allow_origins=[x.strip() for x in origins],
    allow_credentials=True,
    allow_methods=["GET", "POST"],
    allow_headers=["*"],
)

class ChatRequest(BaseModel):
    message: str
    mode: str = "fast"

@app.get("/")
def home():
    return {
        "name": "RAMA AI",
        "status": "Backend running",
        "version": "0.1.0"
    }

@app.get("/health")
def health():
    return {"status": "healthy"}

@app.post("/api/chat")
def chat(request: ChatRequest):
    api_key = os.getenv("GEMINI_API_KEY")

    if not api_key:
        return {
            "error": "Gemini API key is not configured."
        }

    try:
        client = genai.Client(api_key=api_key)

        if request.mode == "deep":
            instruction = (
                "You are RAMA AI. Think carefully, "
                "explain the reasoning clearly, and "
                "give an accurate, structured answer."
            )
        else:
            instruction = (
                "You are RAMA AI. Give a direct, "
                "helpful and concise answer."
            )

        response = client.models.generate_content(
            model=os.getenv(
                "GEMINI_MODEL",
                "gemini-2.5-flash"
            ),
            contents=(
                instruction
                + "\n\nUser: "
                + request.message
            )
        )

        return {
            "reply": response.text or "No response received.",
            "model": os.getenv(
                "GEMINI_MODEL",
                "gemini-2.5-flash"
            ),
            "mode": request.mode
        }

    except Exception as error:
        return {
            "error": "AI request failed.",
            "details": str(error)
        }